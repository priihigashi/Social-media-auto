# ─── YouTube Data API ───────────────────────────────────────────────────────
YOUTUBE_API_KEY=AIza...

# ─── Mosaic API ─────────────────────────────────────────────────────────────
MOSAIC_API_KEY=mk_...
MOSAIC_API_BASE=https://api.usemosaic.ai

# ─── Google Sheets (service account JSON path) ──────────────────────────────
GOOGLE_SERVICE_ACCOUNT_PATH=credentials/service_account.json
SPREADSHEET_NAME=Video Vault

# ─── Niche & Preferences ────────────────────────────────────────────────────
YOUTUBE_NICHE=fitness motivation
CAPTION_COLOR=white
# Max videos to pull per collector run (10–20)
MAX_RESULTS=15

# ─── Output ─────────────────────────────────────────────────────────────────
CLIPS_ROOT=clips

# ─── Canva Connect API ───────────────────────────────────────────────────────
# Get your token at https://www.canva.com/developers/
# Required scopes: asset:read  design:content:read  design:meta:read
#                  folder:read  folder:write
CANVA_API_TOKEN=your_canva_api_token_here
